{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure",
      "type": "shell",
      "command": "cmake --preset Debug",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: Build",
      "type": "shell",
      "command": "cmake --build --preset Debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "CMake: Clean",
      "type": "shell",
      "command": "cmake --build --preset Debug --target clean",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: Rebuild",
      "type": "shell",
      "command": "cmake --build --preset Debug --clean-first",
      "group": "build",
      "problemMatcher": ["$gcc"]
    }
  ]
}
